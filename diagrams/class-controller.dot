digraph "Controller" {
  graph [rankdir=LR, nodesep=0.35, ranksep=0.55, fontname="Helvetica", bgcolor="white", pad=0.2, splines=spline, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=9, fontcolor="#14303B"];
  edge [fontname="Helvetica", fontsize=8, color="#5A707A", fontcolor="#14303B", labeldistance=1.6];

  "MonitorController" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>MonitorController</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-LOGGER: Logger</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-readings: ReadingService</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-reports: ReportStore</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-alerts: AlertMonitor</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-background: Executor</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-ui: Executor</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-clock: Clock</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-view: View</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-listener: PollutionObserver</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-refreshing: AtomicBoolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-saving: AtomicBoolean</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+MonitorController(readings: ReadingService,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; reports: ReportStore, alerts: AlertMonitor,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; background: Executor, ui: Executor, clock: Clock,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; view: View)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+refresh(district: District): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+refreshAll(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-refresh(districts: List&lt;District&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-runRefresh(districts: List&lt;District&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fetch(district: District): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-finishRefresh(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-showReading(district: District,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; result: ReadingService.Result,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; history: List&lt;Reading&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+saveReport(district: District, issue: Issue,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; text: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-queueSave(report: CitizenReport): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+loadReports(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-persist(report: CitizenReport): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-finishSave(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-showReports(saved: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-reportFailure(ex: IOException, message: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+changeThreshold(value: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+subscribe(district: District, enabled: boolean): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "MonitorController.View" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#E6F2F0"><TR><TD><FONT POINT-SIZE="8">«interface»</FONT><BR/><I>View</I></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+loading(value: boolean): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+reading(district: District, result: ReadingService.Result,</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>&#160; &#160; &#160; &#160; recent: List&lt;Reading&gt;): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+reports(entries: List&lt;CitizenReport&gt;): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reportSaving(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+message(message: String, error: boolean): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+alert(history: List&lt;AlertMonitor.Alert&gt;,</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>&#160; &#160; &#160; &#160; delivered: AlertMonitor.Alert): void</I></TD></TR></TABLE></TD></TR></TABLE>>];
  "AlertBridge" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AlertBridge</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~AlertBridge(monitor: AlertMonitor, ui: Executor,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; view: MonitorController.View)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+onAlert(alert: AlertMonitor.Alert): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "ReadingService" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ReadingService</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ReadingService(api: AirQualityGateway,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; cache: ReadingCache, monitor: AlertMonitor)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+refresh(district: District): Result</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+history(district: District): List&lt;Reading&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  "ReportStore" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ReportStore</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-file: Path</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ReportStore(folder: Path)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+list(): List&lt;CitizenReport&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+save(report: CitizenReport): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "CitizenReport" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#EEF1FB"><TR><TD><FONT POINT-SIZE="8">«record»</FONT><BR/><B>CitizenReport</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+MIN_DESCRIPTION: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+MAX_DESCRIPTION: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+DESCRIPTION_RANGE: String</U></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+CitizenReport(id: UUID, district: District, issue: Issue,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; description: String, createdAt: Instant)</TD></TR></TABLE></TD></TR></TABLE>>];
  "AlertMonitor" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AlertMonitor</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+DEFAULT_THRESHOLD: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+MINIMUM_THRESHOLD: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+MAXIMUM_THRESHOLD: int</U></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+AlertMonitor(threshold: int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setThreshold(value: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+subscribe(district: District,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; observer: PollutionObserver): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+unsubscribe(district: District,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; observer: PollutionObserver): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+history(): List&lt;Alert&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+threshold(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+publish(reading: Reading): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "MonitorController" -> "AlertBridge" [dir=back, arrowtail=diamond, label="listener", taillabel="1", headlabel="1"];
  "MonitorController" -> "AlertMonitor" [dir=back, arrowtail=odiamond, label="alerts", taillabel="1", headlabel="1"];
  "MonitorController" -> "ReadingService" [dir=back, arrowtail=odiamond, label="readings", taillabel="1", headlabel="1"];
  "MonitorController" -> "ReportStore" [dir=back, arrowtail=odiamond, label="reports", taillabel="1", headlabel="1"];
  "MonitorController" -> "MonitorController.View" [arrowhead=vee, label="view", headlabel="1"];
  "ReportStore" -> "CitizenReport" [arrowhead=vee, style=dashed, label="list / save"];
}