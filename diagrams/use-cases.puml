@startuml
!pragma layout smetana
skinparam monochrome true
left to right direction
actor Resident
actor "Open-Meteo" as Provider
rectangle "Kuala Lumpur Air & Parks" {
  usecase "Refresh district estimate" as Refresh
  usecase "Compare loaded districts" as Compare
  usecase "Choose an activity profile" as Profile
  usecase "Find nearby green spaces" as Parks
  usecase "Save and view local reports" as Report
  usecase "Subscribe and view alerts" as Alert
}
Resident --> Refresh
Resident --> Compare
Resident --> Profile
Resident --> Parks
Resident --> Report
Resident --> Alert
Provider --> Refresh
@enduml
