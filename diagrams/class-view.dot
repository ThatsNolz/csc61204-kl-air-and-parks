digraph "View layer" {
  graph [rankdir=LR, nodesep=0.35, ranksep=0.55, fontname="Helvetica", bgcolor="white", pad=0.2, splines=spline, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=9, fontcolor="#14303B"];
  edge [fontname="Helvetica", fontsize=8, color="#5A707A", fontcolor="#14303B", labeldistance=1.6];

  "MonitorPanel" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>MonitorPanel</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+MonitorPanel(preferences: Preferences)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+MonitorPanel(preferences: Preferences, fixture: boolean)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+MonitorPanel(preferences: Preferences, fixture: boolean,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; clock: Clock)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+bind(controller: MonitorController): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+loadOnStart(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+loading(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reportSaving(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reading(area: District, result: ReadingService.Result,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; recent: List&lt;Reading&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reports(entries: List&lt;CitizenReport&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+message(text: String, error: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+alert(history: List&lt;AlertMonitor.Alert&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; delivered: AlertMonitor.Alert): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~intensity(): ActivityIntensity</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~window(): ActivityWindow</TD></TR></TABLE></TD></TR></TABLE>>];
  "MonitorController.View" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#E6F2F0"><TR><TD><FONT POINT-SIZE="8">«interface»</FONT><BR/><I>View</I></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+loading(value: boolean): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+reading(district: District, result: ReadingService.Result,</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>&#160; &#160; &#160; &#160; recent: List&lt;Reading&gt;): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+reports(entries: List&lt;CitizenReport&gt;): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reportSaving(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+message(message: String, error: boolean): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+alert(history: List&lt;AlertMonitor.Alert&gt;,</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>&#160; &#160; &#160; &#160; delivered: AlertMonitor.Alert): void</I></TD></TR></TABLE></TD></TR></TABLE>>];
  "Atmosphere" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>Atmosphere</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Atmosphere(layout: LayoutManager)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setCondition(value: Color): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+condition(): Color</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#paintComponent(graphics: Graphics): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "JPanel" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#F2F2F2"><TR><TD><B>JPanel</B></TD></TR></TABLE>>];
  "BasicTabbedPaneUI" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#F2F2F2"><TR><TD><B>BasicTabbedPaneUI</B></TD></TR></TABLE>>];
  "TopBar" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>TopBar</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~TopBar()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~districtSelector(): Dropdown&lt;District&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~refreshButton(): AuroraButton</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~compareButton(): AuroraButton</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~themeButton(): IconButton</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~railButton(): IconButton</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~showTheme(active: AuroraTheme): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~showRail(collapsed: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~showState(label: String, tone: Tone, lastSuccess: Instant,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; now: Instant): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#paintComponent(graphics: Graphics): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "StatusBar" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>StatusBar</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~StatusBar()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~message(text: String, error: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~setBusy(busy: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~showAlert(alert: AlertMonitor.Alert): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~statusLabel(): AuroraLabel</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#paintComponent(graphics: Graphics): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "OverviewPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>OverviewPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~OverviewPane(provenanceDetails: JTextArea)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onDistrictChosen(action: Consumer&lt;District&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(state: ViewState): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "MonitoringPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>MonitoringPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~MonitoringPane()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onDistrictChosen(action: Consumer&lt;District&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(state: ViewState): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~sampleColumn(column: int): List&lt;Object&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "PlannerPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>PlannerPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~PlannerPane(profile: JComboBox&lt;AdviceProfile&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; advice: JTextArea)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onIntensity(action: Consumer&lt;ActivityIntensity&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onWindow(action: Consumer&lt;ActivityWindow&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~restore(savedIntensity: ActivityIntensity,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; savedWindow: ActivityWindow): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(state: ViewState): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>~areas(): List&lt;District&gt;</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "ReportsPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ReportsPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>~ALL_AREAS: String</U></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ReportsPane()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(entries: List&lt;CitizenReport&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~setSaving(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~setInvalid(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onSave(action: Runnable): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~selectDistrict(value: District): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~clearDescription(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~district(): District</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~issue(): Issue</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~description(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "AlertsPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AlertsPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~AlertsPane()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onSubscription(action: BiConsumer&lt;District,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; Boolean&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onThreshold(action: IntConsumer): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~setSubscribed(area: District, enabled: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~setThreshold(value: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(history: List&lt;AlertMonitor.Alert&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "AboutPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AboutPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~AboutPane()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "SettingsPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>SettingsPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~SettingsPane()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onTheme(action: Consumer&lt;AuroraTheme&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onReducedMotion(action: Consumer&lt;Boolean&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onRailCollapsed(action: Consumer&lt;Boolean&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~restore(savedTheme: AuroraTheme, motionReduced: boolean,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; railCollapsed: boolean, dataFolder: Path): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "DistrictStrip" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>DistrictStrip</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~DistrictStrip()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onChoose(action: Consumer&lt;District&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(state: ViewState): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "InsightList" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>InsightList</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~InsightList()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(insights: List&lt;Insight&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "ParkCard" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ParkCard</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ParkCard(name: String)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(district: District, reading: Reading): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "TrendChart" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>TrendChart</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+TrendChart(categoryColour: IntFunction&lt;Color&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; describe: BiFunction&lt;Reading, Boolean, String&gt;)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setHistory(area: District, history: List&lt;Reading&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; alertThreshold: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+highlighted(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#role(): javax.accessibility.AccessibleRole</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#paintComponent(graphics: Graphics): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+axisCeiling(): int</TD></TR></TABLE></TD></TR></TABLE>>];
  "ViewPreferences" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ViewPreferences</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ViewPreferences(store: Preferences)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+district(): District</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+profile(): AdviceProfile</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+theme(): AuroraTheme</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reducedMotion(): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+railCollapsed(): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+intensity(): ActivityIntensity</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+window(): ActivityWindow</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+subscribed(item: District): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+threshold(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+saveDistrict(value: District): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+saveProfile(value: AdviceProfile): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+saveTheme(value: AuroraTheme): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+saveReducedMotion(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+saveRailCollapsed(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+saveIntensity(value: ActivityIntensity): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+saveWindow(value: ActivityWindow): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+saveSubscription(item: District, enabled: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+saveThreshold(value: int): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "NavigationRailUI" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>NavigationRailUI</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">#paint…() / calculate…() overrides of BasicTabbedPaneUI</TD></TR></TABLE></TD></TR></TABLE>>];
  "MonitorPanel" -> "MonitorController.View" [arrowhead=empty, style=dashed];
  "MonitorPanel" -> "Atmosphere" [arrowhead=empty];
  "Atmosphere" -> "JPanel" [arrowhead=empty];
  "MonitorPanel" -> "TopBar" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
