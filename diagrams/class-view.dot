  "MonitoringPane" -> "TrendChart" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  { rank=same; "TopBar"; "StatusBar"; }
  { rank=same; "OverviewPane"; "MonitoringPane"; "PlannerPane"; "ReportsPane"; "AlertsPane"; "AboutPane"; "SettingsPane"; }
  { rank=same; "DistrictStrip"; "InsightList"; "ParkCard"; "TrendChart"; "ViewPreferences"; "NavigationRailUI"; }
}