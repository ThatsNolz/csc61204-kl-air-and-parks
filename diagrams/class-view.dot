  "NavigationRailUI" -> "BasicTabbedPaneUI" [arrowhead=empty];
  "OverviewPane" -> "DistrictStrip" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  "OverviewPane" -> "InsightList" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
