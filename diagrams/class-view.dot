digraph "View layer" {
  graph [rankdir=LR, nodesep=0.35, ranksep=0.55, fontname="Helvetica", bgcolor="white", pad=0.2, splines=spline, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=9, fontcolor="#14303B"];
  edge [fontname="Helvetica", fontsize=8, color="#5A707A", fontcolor="#14303B", labeldistance=1.6];

  "MonitorPanel" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>MonitorPanel</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+MonitorPanel(preferences: Preferences)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+MonitorPanel(preferences: Preferences, fixture: boolean)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+bind(controller: MonitorController): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+loading(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reportSaving(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reading(item: District, result: ReadingService.Result,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; recent: List&lt;Reading&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reports(entries: List&lt;CitizenReport&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+message(text: String, error: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+alert(history: List&lt;AlertMonitor.Alert&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; delivered: AlertMonitor.Alert): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "MonitorController.View" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#E6F2F0"><TR><TD><FONT POINT-SIZE="8">«interface»</FONT><BR/><I>View</I></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+loading(value: boolean): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+reading(district: District, result: ReadingService.Result,</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>&#160; &#160; &#160; &#160; recent: List&lt;Reading&gt;): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+reports(entries: List&lt;CitizenReport&gt;): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reportSaving(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+message(message: String, error: boolean): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+alert(history: List&lt;AlertMonitor.Alert&gt;,</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>&#160; &#160; &#160; &#160; delivered: AlertMonitor.Alert): void</I></TD></TR></TABLE></TD></TR></TABLE>>];
  "JPanel" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#F2F2F2"><TR><TD><B>JPanel</B></TD></TR></TABLE>>];
  "BasicTabbedPaneUI" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#F2F2F2"><TR><TD><B>BasicTabbedPaneUI</B></TD></TR></TABLE>>];
  "OverviewPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>OverviewPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~OverviewPane(details: JTextArea)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onDistrictChosen(action: java.util.function.Consumer&lt;District&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~renderAll(results: java.util.Map&lt;District, Result&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; selected: District): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(district: District, result: Result, source: String,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; profile: AdviceProfile): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "MonitoringPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>MonitoringPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~MonitoringPane()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(selected: District, states: Map&lt;District, Result&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; history: List&lt;Reading&gt;, origin: Function&lt;Result,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; String&gt;, threshold: int): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "AdvicePane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AdvicePane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~AdvicePane(profile: JComboBox&lt;AdviceProfile&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; advice: JTextArea)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(district: District, result: Result, source: String,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; selected: AdviceProfile): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "ReportsPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ReportsPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>~ALL_AREAS: String</U></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ReportsPane()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(entries: List&lt;CitizenReport&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~setSaving(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onSave(action: Runnable): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~selectDistrict(value: District): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~clearDescription(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~district(): District</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~issue(): Issue</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~description(): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "AlertsPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AlertsPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~AlertsPane()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onSubscription(action: BiConsumer&lt;District,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; Boolean&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onThreshold(action: IntConsumer): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~setSubscribed(item: District, enabled: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~setThreshold(value: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(history: List&lt;AlertMonitor.Alert&gt;): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "AboutPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AboutPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~AboutPane()</TD></TR></TABLE></TD></TR></TABLE>>];
  "DistrictStrip" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>DistrictStrip</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~DistrictStrip()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onChoose(action: Consumer&lt;District&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(results: Map&lt;District, Result&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; selected: District): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "AqiScale" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AqiScale</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>~SCALE_MAXIMUM: int</U></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~AqiScale()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~setIndex(value: Integer): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>~position(aqi: int): double</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#paintComponent(graphics: Graphics): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "TrendChart" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>TrendChart</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~TrendChart()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~setHistory(district: District, history: List&lt;Reading&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; alertThreshold: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#paintComponent(graphics: Graphics): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "ViewPreferences" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ViewPreferences</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ViewPreferences(store: Preferences)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~district(): District</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~profile(): AdviceProfile</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~subscribed(item: District): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~threshold(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~saveDistrict(value: District): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~saveProfile(value: AdviceProfile): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~saveSubscription(item: District, enabled: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~saveThreshold(value: int): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "NavigationRailUI" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>NavigationRailUI</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">#paint…() / calculate…() overrides of BasicTabbedPaneUI</TD></TR></TABLE></TD></TR></TABLE>>];
  "MonitorPanel" -> "MonitorController.View" [arrowhead=empty, style=dashed];
  "MonitorPanel" -> "JPanel" [arrowhead=empty];
  "MonitorPanel" -> "OverviewPane" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  "MonitorPanel" -> "MonitoringPane" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  "MonitorPanel" -> "AdvicePane" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  "MonitorPanel" -> "ReportsPane" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  "MonitorPanel" -> "AlertsPane" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  "MonitorPanel" -> "AboutPane" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  "MonitorPanel" -> "ViewPreferences" [dir=back, arrowtail=diamond, label="settings", taillabel="1", headlabel="1"];
  "MonitorPanel" -> "NavigationRailUI" [arrowhead=vee, style=dashed, label="«uses»"];
  "NavigationRailUI" -> "BasicTabbedPaneUI" [arrowhead=empty];
  "OverviewPane" -> "AqiScale" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  "OverviewPane" -> "DistrictStrip" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  "MonitoringPane" -> "TrendChart" [dir=back, arrowtail=diamond, taillabel="1", headlabel="1"];
  { rank=same; "OverviewPane"; "MonitoringPane"; "AdvicePane"; "ReportsPane"; "AlertsPane"; "AboutPane"; }
  { rank=same; "DistrictStrip"; "AqiScale"; "TrendChart"; "ViewPreferences"; "NavigationRailUI"; }
}