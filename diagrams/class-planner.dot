digraph "Activity planning" {
  graph [rankdir=LR, nodesep=0.35, ranksep=0.55, fontname="Helvetica", bgcolor="white", pad=0.2, splines=spline, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=9, fontcolor="#14303B"];
  edge [fontname="Helvetica", fontsize=8, color="#5A707A", fontcolor="#14303B", labeldistance=1.6];

  "PlannerPane" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>PlannerPane</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~PlannerPane(profile: JComboBox&lt;AdviceProfile&gt;,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; advice: JTextArea)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onIntensity(action: Consumer&lt;ActivityIntensity&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~onWindow(action: Consumer&lt;ActivityWindow&gt;): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~restore(savedIntensity: ActivityIntensity,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; savedWindow: ActivityWindow): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~render(state: ViewState): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>~areas(): List&lt;District&gt;</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTheme(): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "ActivityPlanner" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ActivityPlanner</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+BASIS: String</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-SUITABLE_LIMIT: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-ACCEPTABLE_LIMIT: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-MODIFY_LIMIT: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-SENSITIVE_AUDIENCE_WEIGHT: int</U></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-ActivityPlanner()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+plan(category: AirCategory, intensity: ActivityIntensity,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; window: ActivityWindow,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; audience: AdviceProfile): Plan</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+score(category: AirCategory, intensity: ActivityIntensity,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; window: ActivityWindow,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; audience: AdviceProfile): int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-audienceWeight(audience: AdviceProfile): int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-verdict(category: AirCategory, score: int): Verdict</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-reason(category: AirCategory,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; intensity: ActivityIntensity,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; window: ActivityWindow, audience: AdviceProfile,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; score: int): String</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-precautions(category: AirCategory,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; intensity: ActivityIntensity,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; window: ActivityWindow,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; verdict: Verdict): List&lt;String&gt;</U></TD></TR></TABLE></TD></TR></TABLE>>];
  "ActivityPlanner.Plan" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#EEF1FB"><TR><TD><FONT POINT-SIZE="8">«record»</FONT><BR/><B>Plan</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-verdict: Verdict</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-score: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-reason: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-guidance: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-precautions: List&lt;String&gt;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Plan(verdict: Verdict, score: int, reason: String,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; guidance: String, precautions: List&lt;String&gt;)</TD></TR></TABLE></TD></TR></TABLE>>];
  "ActivityPlanner.Verdict" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFF4E0"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>Verdict</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SUITABLE<BR/>ACCEPTABLE<BR/>MODIFY<BR/>RESCHEDULE</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-label: String</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-Verdict(label: String)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+toString(): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "ActivityIntensity" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFF4E0"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>ActivityIntensity</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">LIGHT<BR/>MODERATE<BR/>VIGOROUS</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-label: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-weight: int</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-ActivityIntensity(label: String, weight: int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+weight(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+toString(): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "ActivityWindow" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFF4E0"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>ActivityWindow</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SHORT<BR/>MEDIUM<BR/>LONG</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-label: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-duration: Duration</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-weight: int</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-ActivityWindow(label: String, duration: Duration,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; weight: int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+duration(): Duration</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+weight(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+toString(): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "AirCategory" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFF4E0"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>AirCategory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">GOOD<BR/>MODERATE<BR/>SENSITIVE<BR/>UNHEALTHY<BR/>VERY_UNHEALTHY<BR/>HAZARDOUS</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+from(index: int): AirCategory</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+upperBound(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+toString(): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "GuidelineLevel" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFF4E0"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>GuidelineLevel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PM25<BR/>PM10<BR/>NITROGEN_DIOXIDE<BR/>OZONE</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+CAVEAT: String</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+SOURCE: URI</U></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+level(): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+period(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+toString(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+measure(reading: Reading): Double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+percentOfLevel(reading: Reading): Double</TD></TR></TABLE></TD></TR></TABLE>>];
  "Reading" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#EEF1FB"><TR><TD><FONT POINT-SIZE="8">«record»</FONT><BR/><B>Reading</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Reading(district: District, validAt: Instant,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; fetchedAt: Instant, aqi: int, pm25: Double,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; pm10: Double, nitrogenDioxide: Double,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; ozone: Double)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+category(): AirCategory</TD></TR></TABLE></TD></TR></TABLE>>];
  "PlannerPane" -> "ActivityPlanner" [arrowhead=vee, style=dashed, label="plan(...)"];
  "ActivityPlanner" -> "ActivityPlanner.Plan" [arrowhead=vee, style=dashed, label="«create»"];
  "ActivityPlanner.Plan" -> "ActivityPlanner.Verdict" [arrowhead=vee, label="verdict", headlabel="1"];
  "ActivityPlanner" -> "ActivityIntensity" [arrowhead=vee, style=dashed, label="scores"];
  "ActivityPlanner" -> "ActivityWindow" [arrowhead=vee, style=dashed, label="scores"];
  "ActivityPlanner" -> "AirCategory" [arrowhead=vee, style=dashed, label="scores"];
  "Reading" -> "AirCategory" [arrowhead=vee, style=dashed, label="category()"];
  "Reading" -> "GuidelineLevel" [arrowhead=vee, label="measured against", headlabel="0..*"];
  { rank=same; "ActivityIntensity"; "ActivityWindow"; "AirCategory"; }
  { rank=same; "ActivityPlanner.Plan"; "ActivityPlanner.Verdict"; }
}