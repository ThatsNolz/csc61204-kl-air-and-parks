digraph "Observer" {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.55, fontname="Helvetica", bgcolor="white", pad=0.2, splines=spline, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=9, fontcolor="#14303B"];
  edge [fontname="Helvetica", fontsize=8, color="#5A707A", fontcolor="#14303B", labeldistance=1.6];

  "AlertMonitor" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AlertMonitor</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+DEFAULT_THRESHOLD: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+MINIMUM_THRESHOLD: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+MAXIMUM_THRESHOLD: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-HISTORY_LIMIT: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-LOGGER: Logger</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-threshold: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-latest: Map&lt;District, Reading&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-subscriptions: Map&lt;District, Set&lt;PollutionObserver&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-history: ArrayDeque&lt;Alert&gt;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+AlertMonitor(threshold: int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setThreshold(value: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+subscribe(district: District,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; observer: PollutionObserver): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+unsubscribe(district: District,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; observer: PollutionObserver): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+history(): List&lt;Alert&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+threshold(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+publish(reading: Reading): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-crossed(reading: Reading): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-notifyListener(listener: PollutionObserver,</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>&#160; &#160; &#160; &#160; alert: Alert): void</U></TD></TR></TABLE></TD></TR></TABLE>>];
  "AlertMonitor.Alert" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#EEF1FB"><TR><TD><FONT POINT-SIZE="8">«record»</FONT><BR/><B>Alert</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-district: District</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-aqi: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-threshold: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-validAt: Instant</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR></TABLE>>];
  "PollutionObserver" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#E6F2F0"><TR><TD><FONT POINT-SIZE="8">«interface»</FONT><BR/><I>PollutionObserver</I></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+onAlert(alert: AlertMonitor.Alert): void</I></TD></TR></TABLE></TD></TR></TABLE>>];
  "AlertBridge" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AlertBridge</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-monitor: AlertMonitor</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-ui: Executor</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-view: MonitorController.View</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">~AlertBridge(monitor: AlertMonitor, ui: Executor,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; view: MonitorController.View)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+onAlert(alert: AlertMonitor.Alert): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "MonitorController.View" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#E6F2F0"><TR><TD><FONT POINT-SIZE="8">«interface»</FONT><BR/><I>View</I></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+loading(value: boolean): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+reading(district: District, result: ReadingService.Result,</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>&#160; &#160; &#160; &#160; recent: List&lt;Reading&gt;): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+reports(entries: List&lt;CitizenReport&gt;): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reportSaving(value: boolean): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+message(message: String, error: boolean): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+alert(history: List&lt;AlertMonitor.Alert&gt;,</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>&#160; &#160; &#160; &#160; delivered: AlertMonitor.Alert): void</I></TD></TR></TABLE></TD></TR></TABLE>>];
  "ReadingService" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ReadingService</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ReadingService(api: AirQualityGateway,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; cache: ReadingCache, monitor: AlertMonitor)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+refresh(district: District): Result</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+history(district: District): List&lt;Reading&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  "AlertBridge" -> "PollutionObserver" [arrowhead=empty, style=dashed];
  "ReadingService" -> "AlertMonitor" [arrowhead=vee, label="publish(reading)", headlabel="1"];
  "AlertMonitor" -> "PollutionObserver" [dir=back, arrowtail=odiamond, label="subscriptions", taillabel="1", headlabel="0..*"];
  "AlertMonitor" -> "AlertMonitor.Alert" [dir=back, arrowtail=diamond, label="history", taillabel="1", headlabel="0..100"];
  "AlertBridge" -> "AlertMonitor" [arrowhead=vee, label="monitor", headlabel="1"];
  "AlertBridge" -> "MonitorController.View" [arrowhead=vee, label="view", headlabel="1"];
  { rank=same; "ReadingService"; "AlertMonitor"; }
  { rank=same; "AlertMonitor.Alert"; "PollutionObserver"; "AlertBridge"; }
}