digraph "Service and API" {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.55, fontname="Helvetica", bgcolor="white", pad=0.2, splines=spline, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=9, fontcolor="#14303B"];
  edge [fontname="Helvetica", fontsize=8, color="#5A707A", fontcolor="#14303B", labeldistance=1.6];

  "ReadingService" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ReadingService</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-HISTORY_LIMIT: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-LOGGER: Logger</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-api: AirQualityGateway</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-cache: ReadingCache</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-monitor: AlertMonitor</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-memory: Map&lt;District, Reading&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-history: Map&lt;District, ArrayDeque&lt;Reading&gt;&gt;</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ReadingService(api: AirQualityGateway,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; cache: ReadingCache, monitor: AlertMonitor)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+refresh(district: District): Result</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+history(district: District): List&lt;Reading&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-remember(reading: Reading): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fallback(district: District, message: String): Result</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-cached(district: District): Reading</TD></TR></TABLE></TD></TR></TABLE>>];
  "ReadingService.Result" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#EEF1FB"><TR><TD><FONT POINT-SIZE="8">«record»</FONT><BR/><B>Result</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-state: State</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-reading: Reading</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-message: String</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Result(state: State, reading: Reading, message: String)</TD></TR></TABLE></TD></TR></TABLE>>];
  "ReadingService.State" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFF4E0"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>State</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">LIVE<BR/>CACHED<BR/>UNAVAILABLE</TD></TR></TABLE>>];
  "AirQualityGateway" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#E6F2F0"><TR><TD><FONT POINT-SIZE="8">«interface»</FONT><BR/><I>AirQualityGateway</I></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+fetch(district: District): Reading</I></TD></TR></TABLE></TD></TR></TABLE>>];
  "OpenMeteoClient" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>OpenMeteoClient</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ENDPOINT: URI</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ZONE: ZoneId</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-OK: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-REDIRECT: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-NOT_FOUND_STATUS: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-RATE_STATUS: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-SERVER_STATUS: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-FIELDS: String</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-endpoint: URI</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-http: HttpClient</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-json: ObjectMapper</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-timeout: Duration</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-clock: Clock</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+OpenMeteoClient(endpoint: URI, http: HttpClient,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; timeout: Duration, clock: Clock)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+fetch(district: District): Reading</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-requestUri(district: District): URI</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-checkStatus(status: int): void</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-parse(district: District, body: String): Reading</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-toReading(district: District, current: JsonNode): Reading</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-pollutant(current: JsonNode, field: String): Double</U></TD></TR></TABLE></TD></TR></TABLE>>];
  "ApiFailure" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ApiFailure</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-kind: Kind</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ApiFailure(kind: Kind, message: String, cause: Throwable)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+kind(): Kind</TD></TR></TABLE></TD></TR></TABLE>>];
  "ApiFailure.Kind" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFF4E0"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>Kind</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">NOT_FOUND<BR/>SERVER<BR/>RATE_LIMIT<BR/>HTTP<BR/>TIMEOUT<BR/>NETWORK<BR/>INVALID</TD></TR></TABLE>>];
  "Exception" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#F2F2F2"><TR><TD><B>Exception</B></TD></TR></TABLE>>];
  "ReadingCache" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ReadingCache</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-folder: Path</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ReadingCache(folder: Path)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+load(district: District): Optional&lt;Reading&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+save(reading: Reading): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-file(district: District): Path</TD></TR></TABLE></TD></TR></TABLE>>];
  "Reading" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#EEF1FB"><TR><TD><FONT POINT-SIZE="8">«record»</FONT><BR/><B>Reading</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-district: District</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-validAt: Instant</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fetchedAt: Instant</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-aqi: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pm25: Double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pm10: Double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-nitrogenDioxide: Double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-ozone: Double</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Reading(district: District, validAt: Instant,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; fetchedAt: Instant, aqi: int, pm25: Double,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; pm10: Double, nitrogenDioxide: Double,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; ozone: Double)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+category(): AirCategory</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-validate(value: Double): void</U></TD></TR></TABLE></TD></TR></TABLE>>];
  "AlertMonitor" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>AlertMonitor</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+DEFAULT_THRESHOLD: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+MINIMUM_THRESHOLD: int</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+MAXIMUM_THRESHOLD: int</U></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+AlertMonitor(threshold: int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setThreshold(value: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+subscribe(district: District,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; observer: PollutionObserver): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+unsubscribe(district: District,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; observer: PollutionObserver): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+history(): List&lt;Alert&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+threshold(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+publish(reading: Reading): void</TD></TR></TABLE></TD></TR></TABLE>>];
  "OpenMeteoClient" -> "AirQualityGateway" [arrowhead=empty, style=dashed];
  "ApiFailure" -> "Exception" [arrowhead=empty];
  "ReadingService" -> "AirQualityGateway" [dir=back, arrowtail=odiamond, label="api", taillabel="1", headlabel="1"];
  "ReadingService" -> "ReadingCache" [dir=back, arrowtail=odiamond, label="cache", taillabel="1", headlabel="1"];
  "ReadingService" -> "AlertMonitor" [dir=back, arrowtail=odiamond, label="monitor", taillabel="1", headlabel="1"];
  "ReadingService" -> "Reading" [arrowhead=vee, label="memory, history", taillabel="1", headlabel="0..*"];
  "ReadingService" -> "ReadingService.Result" [arrowhead=vee, style=dashed, label="«create»"];
  "ReadingService.Result" -> "ReadingService.State" [arrowhead=vee, label="state", headlabel="1"];
  "ReadingService.Result" -> "Reading" [arrowhead=vee, label="reading", headlabel="0..1"];
  "OpenMeteoClient" -> "ApiFailure" [arrowhead=vee, style=dashed, label="«throw»"];
  "OpenMeteoClient" -> "Reading" [arrowhead=vee, style=dashed, label="«create»"];
  "ApiFailure" -> "ApiFailure.Kind" [arrowhead=vee, label="kind", headlabel="1"];
  "ReadingCache" -> "Reading" [arrowhead=vee, style=dashed, label="load / save"];
  { rank=same; "ReadingService"; "AlertMonitor"; }
  { rank=same; "AirQualityGateway"; "ReadingCache"; "ReadingService.Result"; }
  { rank=same; "OpenMeteoClient"; "Reading"; "ReadingService.State"; }
  { rank=same; "ApiFailure"; "ApiFailure.Kind"; "Exception"; }
}