digraph "Strategy and domain" {
  graph [rankdir=TB, nodesep=0.35, ranksep=0.55, fontname="Helvetica", bgcolor="white", pad=0.2, splines=spline, newrank=true];
  node [shape=plain, fontname="Helvetica", fontsize=9, fontcolor="#14303B"];
  edge [fontname="Helvetica", fontsize=8, color="#5A707A", fontcolor="#14303B", labeldistance=1.6];

  "AdviceProfile" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFF4E0"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>AdviceProfile</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">GENERAL<BR/>CHILDREN<BR/>OLDER_ADULTS</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-label: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-strategy: AdviceStrategy</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-AdviceProfile(label: String, strategy: AdviceStrategy)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+strategy(): AdviceStrategy</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+toString(): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "AdviceStrategy" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#E6F2F0"><TR><TD><FONT POINT-SIZE="8">«interface»</FONT><BR/><I>AdviceStrategy</I></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+advice(category: AirCategory): String</I></TD></TR></TABLE></TD></TR></TABLE>>];
  "GeneralPublicAdvice" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>GeneralPublicAdvice</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+advice(category: AirCategory): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "ChildrenAdvice" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>ChildrenAdvice</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+advice(category: AirCategory): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "OlderAdultsAdvice" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>OlderAdultsAdvice</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+advice(category: AirCategory): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "AirCategory" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFF4E0"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>AirCategory</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">GOOD<BR/>MODERATE<BR/>SENSITIVE<BR/>UNHEALTHY<BR/>VERY_UNHEALTHY<BR/>HAZARDOUS</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-label: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-upperBound: int</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-AirCategory(label: String, upperBound: int)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+from(index: int): AirCategory</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+upperBound(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+toString(): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "District" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFF4E0"><TR><TD><FONT POINT-SIZE="8">«enumeration»</FONT><BR/><B>District</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">TITIWANGSA<BR/>CITY_CENTRE<BR/>PERDANA</TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-label: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-latitude: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-longitude: double</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-District(label: String, latitude: double,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; longitude: double)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+latitude(): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+longitude(): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+toString(): String</TD></TR></TABLE></TD></TR></TABLE>>];
  "CityCatalog" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#FFFFFF"><TR><TD><B>CityCatalog</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-DBKL_PARKS: String</U></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-CityCatalog()</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+nearby(district: District): List&lt;Park&gt;</U></TD></TR></TABLE></TD></TR></TABLE>>];
  "CityCatalog.Park" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#EEF1FB"><TR><TD><FONT POINT-SIZE="8">«record»</FONT><BR/><B>Park</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-name: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-area: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-source: URI</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD> </TD></TR></TABLE></TD></TR></TABLE>>];
  "Reading" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#5A707A" BGCOLOR="#EEF1FB"><TR><TD><FONT POINT-SIZE="8">«record»</FONT><BR/><B>Reading</B></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-district: District</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-validAt: Instant</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fetchedAt: Instant</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-aqi: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pm25: Double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pm10: Double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-nitrogenDioxide: Double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-ozone: Double</TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT"><TABLE BORDER="0" CELLPADDING="0" CELLSPACING="0"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Reading(district: District, validAt: Instant,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; fetchedAt: Instant, aqi: int, pm25: Double,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; pm10: Double, nitrogenDioxide: Double,</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">&#160; &#160; &#160; &#160; ozone: Double)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+category(): AirCategory</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>-validate(value: Double): void</U></TD></TR></TABLE></TD></TR></TABLE>>];
  "GeneralPublicAdvice" -> "AdviceStrategy" [arrowhead=empty, style=dashed];
  "ChildrenAdvice" -> "AdviceStrategy" [arrowhead=empty, style=dashed];
  "OlderAdultsAdvice" -> "AdviceStrategy" [arrowhead=empty, style=dashed];
  "AdviceProfile" -> "AdviceStrategy" [dir=back, arrowtail=diamond, label="strategy", taillabel="1", headlabel="1"];
  "AdviceStrategy" -> "AirCategory" [arrowhead=vee, style=dashed, label="advice(category)"];
  "Reading" -> "District" [arrowhead=vee, label="district", headlabel="1"];
  "Reading" -> "AirCategory" [arrowhead=vee, style=dashed, label="category()"];
  "CityCatalog" -> "CityCatalog.Park" [arrowhead=vee, style=dashed, label="nearby() returns"];
  "CityCatalog" -> "District" [arrowhead=vee, style=dashed, label="keyed by"];
  { rank=same; "AdviceProfile"; "Reading"; }
  { rank=same; "AdviceStrategy"; "District"; "CityCatalog"; }
  { rank=same; "GeneralPublicAdvice"; "ChildrenAdvice"; "OlderAdultsAdvice"; }
  { rank=same; "AirCategory"; "CityCatalog.Park"; }
}